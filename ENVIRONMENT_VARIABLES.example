# Configure these as private Runtime environment variables in Netlify UI.
# Do not commit .env files or real values to Git.
STAYHUB_ADMIN_EMAIL=YOUR_ADMIN_EMAIL@example.com
STAYHUB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
STAYHUB_OTP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
RESEND_API_KEY=REPLACE_WITH_PRIVATE_RESEND_API_KEY
STAYHUB_FROM_EMAIL=StayHub <verify@YOUR_VERIFIED_DOMAIN.com>
STAYHUB_PUBLIC_ORIGIN=https://YOUR-PUBLIC-SITE.netlify.app
STAYHUB_ADMIN_ORIGIN=https://YOUR-ADMIN-SITE.netlify.app
